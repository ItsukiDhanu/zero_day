generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  PARTICIPANT
  ORGANIZER
  JUDGE
  ADMIN
}

enum AcademicYear {
  FIRST_YEAR  @map("1st Year")
  SECOND_YEAR @map("2nd Year")
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentPurpose {
  REGISTRATION
  EXTRA_SLOT
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  passwordHash String?  @map("password_hash")
  passwordResetTokenHash String? @map("password_reset_token_hash") @db.Char(64)
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")
  role        UserRole @default(PARTICIPANT)
  name        String?
  year        AcademicYear?
  branch      String?
  phoneNumber String?

  // If a team is deleted, keep user record and null out teamId.
  teamId String? @db.Uuid
  team   Team?   @relation("TeamMembership", fields: [teamId], references: [id], onDelete: SetNull)

  captainedTeams Team[] @relation("TeamCaptain")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([passwordResetTokenHash])
  @@index([createdAt])
}

model Team {
  id        String @id @default(uuid()) @db.Uuid
  name      String
  joinCode  String @unique @map("join_code") @db.Char(6)
  repositoryUrl String? @map("repository_url")
  members   User[] @relation("TeamMembership")
  judgingScore TeamJudgingScore?
  payments  TeamPayment[]
  extraSlotUnlocked Boolean @default(false) @map("extra_slot_unlocked")

  captainId String? @map("captain_id") @db.Uuid
  captain   User?   @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([captainId])
  @@index([createdAt])

  // Prisma cannot enforce relation-cardinality max(4) in schema DSL.
  // Enforce 4-member cap in app logic and/or a SQL trigger/check in migration.
}

model TeamJudgingScore {
  id                    String   @id @default(uuid()) @db.Uuid
  teamId                String   @unique @map("team_id") @db.Uuid
  innovationScore       Int      @default(0) @map("innovation_score")
  impactScore           Int      @default(0) @map("impact_score")
  implementationScore   Int      @default(0) @map("implementation_score")
  presentationScore     Int      @default(0) @map("presentation_score")
  ruleAdherenceScore    Int      @default(0) @map("rule_adherence_score")
  comments              String?
  updatedByEmail        String?  @map("updated_by_email")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model TeamPayment {
  id                    String   @id @default(uuid()) @db.Uuid
  teamId                String   @map("team_id") @db.Uuid
  status                PaymentStatus @default(PENDING)
  paymentPurpose        PaymentPurpose @default(REGISTRATION) @map("payment_purpose")
  paymentMethod         String   @map("payment_method")
  transactionReference  String   @map("transaction_reference")
  proofFileUrl          String?  @map("proof_file_url")
  receiptFileName        String?  @map("receipt_file_name")
  receiptMimeType        String?  @map("receipt_mime_type")
  receiptData            Bytes?   @map("receipt_data")
  rejectionReason       String?  @map("rejection_reason")
  verifiedByEmail       String?  @map("verified_by_email")
  verifiedAt            DateTime? @map("verified_at")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
  @@unique([teamId, paymentPurpose])
}

model SiteSettings {
  id               String   @id @default(uuid()) @db.Uuid
  singletonKey     String   @unique @default("global")
  registrationOpen Boolean  @default(true)
  repositorySubmissionOpen Boolean @default(false) @map("repository_submission_open")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
